# SLURM settings
cluster:
  submit: sbatch
  cancel: scancel
  status: squeue

# Job settings
job:
  resources:
    cpus-per-task: 1
    mem: 1G
    time: 01:00:00


# QoS settings
qos:
  default: my_qos

# Mail settings
mail:
  user: christoph.stritt@swisstph.ch
  on-fail: true
  on-done: true

# SLURM specific settings
slurm:
  job-name: "{rule}"
  output: "{rule}.%j.out"
  error: "{rule}.%j.err"
  nodes: 1
  ntasks-per-node: 1
  cpus-per-task: "{threads}"
  mem: "{resources.mem}"
  time: "{resources.time}"
  partition: "{partition}"
  account: "{account}"
  qos: "{qos}"




default-resources:
    time: "00:29:00",
    qos: "30min",
    n: 4,
    mem: "8G"



set-resources:
    isescan:
        slurm_partition: "<other partition>" # deviating partition for this rule
        runtime: 60 # 1 hour
        slurm_extra: "'--nice=150'"
        mem_mb_per_cpu: 1800
        cpus_per_task: 40

    detettore:
        